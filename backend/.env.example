# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Configuration
# Either set DATABASE_URL (Neon, Supabase, etc.) or the discrete DB_* values below.
DB_ENABLED=false
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=university_datahub
DB_USER=your_db_username_here
DB_PASSWORD=your_db_password_here
DB_SSL=false
# Use DB_SSL=true for hosted providers such as Neon

# Authentication (generate strong random values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_TTL_DAYS_REMEMBER=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
SEED_ADMIN_PASSWORD=admin123
SEED_LIBRARY_STAFF_PASSWORD=

# Password reset email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000
