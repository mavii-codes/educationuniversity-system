# Base URL for the Express.js REST API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Set to "false" to use the built-in mock dataset instead of the live API
NEXT_PUBLIC_USE_LIVE_API=true

# Local demo sign-in helper passwords (must match backend SEED_* passwords).
# Leave blank in shared environments.
NEXT_PUBLIC_DEV_ADMIN_PASSWORD=
NEXT_PUBLIC_DEV_REGISTRAR_PASSWORD=
